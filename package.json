{
  "name": "webnav-hub",
  "description": "WebNav Hub - 精选 AI 搜索、开发者工具与云服务导航 (Qwik 2 + Qwik Router)",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run build.types && bun run build.client && bun run build.server",
    "build.client": "vite build",
    "build.server": "vite build -c adapters/static/vite.config.ts",
    "build.types": "tsc --noEmit",
    "dev": "vite --mode ssr",
    "dev.debug": "node --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --force",
    "preview": "vite preview",
    "qwik": "qwik"
  },
  "devDependencies": {
    "@qwik.dev/core": "2.0.0-rc.4",
    "@qwik.dev/router": "2.0.0-rc.4",
    "@types/node": "^26.6.6",
    "ignore": "^7.0.14",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "engines": {
    "bun": ">=1.2.0"
  }
}
